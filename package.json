{
  "name": "acl-video-generator",
  "version": "1.0.0",
  "description": "ACL Accelerator — AI-powered product demo video generator",
  "scripts": {
    "postinstall": "patch-package",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cover": "jest --coverage",
    "start": "ts-node --project tsconfig.scripts.json automation/start-studio.ts",
    "render:demo": "ts-node --project tsconfig.scripts.json automation/render-demo.ts",
    "render:demo:preview": "ts-node --project tsconfig.scripts.json automation/render-demo.ts --scale 0.5 --crf 28",
    "voice": "ts-node --project tsconfig.scripts.json automation/generate-voice.ts",
    "voice:only": "ts-node --project tsconfig.scripts.json automation/generate-voice.ts --no-merge",
    "render:demo:voice": "npm run render:demo && npm run voice",
    "record": "ts-node --project tsconfig.scripts.json automation/record.ts --mode workflows",
    "record:explore": "ts-node --project tsconfig.scripts.json automation/record.ts --mode explore",
    "sync": "ts-node --project tsconfig.scripts.json automation/sync.ts",
    "validate": "ts-node --project tsconfig.scripts.json render/validate.ts",
    "pipeline": "ts-node --project tsconfig.scripts.json render/pipeline.ts",
    "e2e-test": "ts-node --project tsconfig.scripts.json automation/e2e-test.ts",
    "playwright:install": "playwright install chromium",
    "record:enterprise": "ts-node --project tsconfig.scripts.json automation/record-enterprise-clips.ts",
    "pipeline:enterprise": "ts-node --project tsconfig.scripts.json automation/record-app-clips.ts",
    "pipeline:enterprise:render": "npm run render:demo && npm run voice",
    "pipeline:teaser": "ts-node --project tsconfig.scripts.json automation/record-teaser-clips.ts",
    "pipeline:teaser:render": "npm run render:demo",
    "record:agent-exhaustive": "ts-node --project tsconfig.scripts.json automation/record-agent-exhaustive.ts",
    "record:agent-exhaustive:narrate": "ts-node --project tsconfig.scripts.json automation/record-agent-exhaustive.ts --narrate",
    "manual-recording:process": "ts-node --project tsconfig.scripts.json automation/process-manual-recording.ts",
    "manual-recording:enterprise": "ts-node --project tsconfig.scripts.json automation/manual-recording-to-enterprise.ts",
    "manual-recording:fix-demo": "ts-node --project tsconfig.scripts.json automation/fix-manual-recording-demo.ts",
    "broll:download": "ts-node --project tsconfig.scripts.json automation/download-broll-videos.ts",
    "broll:register": "ts-node --project tsconfig.scripts.json automation/register-broll-videos.ts",
    "broll:premium": "ts-node --project tsconfig.scripts.json automation/download-broll-premium.ts",
    "record:flow": "ts-node --project tsconfig.scripts.json automation/record-flow.ts",
    "presenter:generate": "ts-node --project tsconfig.scripts.json automation/generate-presenter-video.ts",
    "broll:did": "ts-node --project tsconfig.scripts.json automation/generate-broll-videos.ts",
    "music:fetch": "ts-node --project tsconfig.scripts.json automation/fetch-background-music.ts",
    "music:fetch:force": "ts-node --project tsconfig.scripts.json automation/fetch-background-music.ts -- --force",
    "config-ui": "ts-node --project tsconfig.scripts.json automation/config-server.ts",
    "https-proxy": "ts-node --project tsconfig.scripts.json automation/https-proxy.ts",
    "dev": "concurrently --names \"config,studio,https\" -c \"cyan,magenta,green\" \"npm run config-ui\" \"npm start\" \"npm run https-proxy\""
  },
  "dependencies": {
    "@remotion/cli": "^4.0.257",
    "@remotion/media-utils": "^4.0.257",
    "edge-tts": "^1.0.1",
    "fast-json-patch": "^3.1.1",
    "multer": "^2.2.0",
    "openai": "^6.42.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.257"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.0",
    "express": "^5.2.1",
    "jest": "^30.4.2",
    "jimp": "^1.6.1",
    "patch-package": "^8.0.1",
    "playwright": "^1.44.0",
    "selfsigned": "^5.5.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "remotion": {
    "entryPoint": "src/index.tsx"
  }
}
